DATABASE_URL="file:./dev.db"
AI_MODE="mock"
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""

# OpenAI Responses API. Set AI_MODE=live and AI_PROVIDER=openai only when ready.
# Keep the key in the local .env; never send it to the browser or commit it.
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Local hackathon demo. Codes appear in the UI; no SMS is sent.
APP_URL="http://127.0.0.1:3000"
AUTH_MODE="mock"
ALLOW_MOCK_AUTH="true"

# For real SMS: AUTH_MODE=twilio, ALLOW_MOCK_AUTH=false, APP_URL=https://your-domain
# Keep credentials server-side and out of Git. Enable destination countries in Twilio Verify.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
